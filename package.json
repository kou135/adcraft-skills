{
  "name": "adcraft",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code Skills that auto-generate advertisement videos with Remotion. Self-loop: generate -> visual verify -> self-correct -> output/.",
  "license": "MIT",
  "author": "Kota Suzuki",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "remotion:studio": "remotion studio remotion/src/Root.tsx",
    "remotion:still": "remotion still",
    "remotion:render": "remotion render",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "remotion": "^4.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
