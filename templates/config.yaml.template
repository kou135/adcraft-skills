# {{PRODUCT_NAME}} の広告動画生成設定
#
# このファイルは Skill `extract-product-ui` が生成したひな形です。
# Skill `create-advertisement` がこの設定を読み、生成計画を立てます。
# 配信関連の設定（Git push 先・SNS 投稿等）は本 Skill の責務外のため
# このスキーマには含まれません。

product_name: "{{PRODUCT_NAME}}"
description: ""

formats:
  reel:
    enabled: true
    count: 5
    duration: 25      # 秒。20〜30 推奨
    aspect: "9:16"
    fps: 30

  slide_image:
    enabled: false
    count: 0
    aspect: "1:1"
    slides_per_set: 5

  horizontal:
    enabled: false
    count: 0
    duration: 25
    aspect: "16:9"
    fps: 30

  blog:
    enabled: false
    count: 0
    target_word_count: 1500

output:
  base_dir: "./output"

validation:
  max_iteration: 3
  check_frames: [0, "mid", "end"]
  strict_mode: false

variation:
  strategy: "auto"   # "auto" or "manual"
  # strategy: "manual" の場合のみ以下を有効化:
  # manual_directions:
  #   - "機能訴求"
  #   - "問題解決"
  #   - "Before/After"
  #   - "ユーザーストーリー"
  #   - "差別化"

# create-advertisement-with-higgsfield skill 用設定
# 使わない場合は higgsfield.enabled: false にすればOK（既存 create-advertisement のみ動く）
higgsfield:
  enabled: false              # true にすると新skillが起動可能になる
  cost_limit_usd: 10.00       # 1run あたりのハードコスト上限（USD）
  cost_safety_margin: 0.95    # 実停止しきい値（limit_usd * safety_margin で abort）
  shots_per_video: 4          # 1動画あたりカット数
  shot_duration_sec: 5        # 1カット秒数（合計 = formats.reel.duration と一致させる）
  parallel: false             # MVP は直列固定
  image:
    model_preference:
      - "gpt-image-2"         # 第一優先
      - "nano-banana-2"       # fallback
    max_iterations_per_shot: 3  # 初回 + リトライ最大2回
  video:
    # 2026-04-09 以降、Seedance 2.0 は全プラン (Starter 含む) で開放済み。
    # 呼出時に `mode: "fast"` を明示しないと std で叩かれ、Starter では
    # 402 paid_plan_required になりやすい。SKILL.md Step 6 参照。
    model_preference:
      - "seedance_2_0"        # 1st: 公式 ID。`mode: "fast"` で呼ぶこと (fast 720p ≒ 17 cred/5s)
      - "kling2_6"            # 2nd: starter 安定 (10 cred/shot @ 5s)、seedance 402 時の fallback
    one_shot: true            # true: 動画失敗時は静止画fallback、再生成しない
    fallback_to_static: true
  tts:
    # R-H18: TTS は opt-in。デフォルト false (lite モード) でナレーション台本のみ .md に生成
    #        true にすると ElevenLabs API で自動生成 + ffmpeg post-master (R-H15/16 適用)
    enabled: false            # default OFF（lite モード）。手動で narration を当てる前提
    provider: "elevenlabs"
    voice_id: ""              # ElevenLabs voice ID（enabled: true 時に必須）
    model_id: "eleven_turbo_v2_5"
  bgm:
    # R-H18: BGM 自動埋込も opt-in。デフォルト false で CapCut 等で手動付与
    required: false           # default OFF。true なら assets/bgm/*.mp3 を <Audio> で全 shot 通敷
    selection: "auto"         # auto / explicit。explicit なら下の explicit_file 指定
    # explicit_file: "energetic-01.mp3"

# create-advertisement-with-runway skill 用設定 (Skill D)
# 使わない場合は runway.enabled: false（既存 create-advertisement / higgsfield のみ動く）
# 接続は hosted MCP（https://mcp.runwayml.com/mcp, OAuth）。clone / API キー不要。
# 課金は Runway の Web サブスク・クレジット枠（Higgsfield と同型）。真のハードキャップ = 月次クレジット枠（Standard 625/月 等）。
#
# 動画の既定は Kling 3.0 Pro：Runway 自社 Gen-4.5 超の品質かつ seedance2(36/s) より大幅に安い（Standard で月2-3本）。
#    最安重視なら kling3.0_std（9/s 無音）に、最高品質なら happyhorse_1_0 に、最安なら gen4_turbo(5/s, 品質一段下) に切替可。
#    seedance2 は Standard だと 4カットで月次枠超過（180cr/5s）するため既定から外している。
#    ⚠️ Kling/Veo/HappyHorse の **実 model ID literal は接続時に /mcp で確認**（下記は暫定）。
#    ⚠️ web-app のモデル別クレジット消費は接続テストで実測校正すること。
runway:
  enabled: false              # true にすると Skill D が起動可能になる
  credit_limit_per_run: 200   # 1run の推定消費クレジット上限（hosted の主単位）。月次枠を1runで食い潰さない安全弁
  cost_limit_usd: 10.00       # USD 概算 proxy（cost_tracker 連携用）。credit_limit と先に到達した方で abort
  cost_safety_margin: 0.95    # 実停止しきい値（limit * safety_margin で abort）
  shots_per_video: 4          # 1動画あたりカット数
  shot_duration_sec: 5        # gen4_turbo/gen4.5 の duration enum は [5,10]。
                              # ⚠️ shots_per_video × shot_duration_sec を formats.reel.duration に一致させる
                              #    （既定 4×5=20s。formats.reel.duration が 25s 等なら shot 構成を合わせること）
  parallel: false             # MVP は直列固定
  ratio: "720:1280"           # 動画(image_to_video)の 9:16 pixel 文字列（"9:16" は不可、R-R19）。
                              # ※ 画像生成(gen4_image/gpt_image_2)は ratio enum が別系統の可能性。実 run で確認し、
                              #    必要なら image.ratio を別途指定（R-R19.3）
  image:
    # model ID literal 厳守（gen4_image はアンダースコア、R-R19）
    model_preference:
      - "gpt_image_2"         # 1st: OpenAI（Higgsfield 版と同条件比較用、見積は worst case 41cr で計上）
      - "gen4_image"          # fallback: Runway native（5cr@720p=$0.05、安価）
    max_iterations_per_shot: 3  # 初回 + リトライ最大2回
    # ratio: "1080:1920"      # （任意）画像生成専用 ratio。未指定なら上位 ratio を使う
  video:
    # 既定 = Kling 3.0 Pro（Gen-4.5 超品質 / 12cr·s 無音 = 5s 60cr）。fallback に安価な gen4_turbo。
    # ※ 実 model ID は接続時 /mcp で確認（"kling3.0_pro" 等は暫定）。最安重視は kling3.0_std に。
    model_preference:
      - "kling3.0_pro"        # 1st: Runway 自社超え品質 + seedance2 より安い（無音 12cr/s）
      - "gen4_turbo"          # fallback: Runway native、最安・安定（5cr/s、cost guard 安全弁）
      # - "kling3.0_std"      # 代替: さらに安い（無音 9cr/s、月3本）
      # - "happyhorse_1_0"    # 代替: 無音アリーナ最上位（720p 15cr/s）
      # - "seedance2"         # 比較用（高コスト。Standard では月1本未満になる点に注意）
    one_shot: true            # true: 動画失敗時は次候補→静止画fallback、同一モデルは再生成しない
    fallback_to_static: true
  tts:
    # R-R18: TTS は opt-in。デフォルト false (lite モード) でナレーション台本のみ .md に生成
    enabled: false            # default OFF（lite モード）。手動で narration を当てる前提
    provider: "elevenlabs"
    voice_id: ""              # ElevenLabs voice ID（enabled: true 時に必須）
    model_id: "eleven_turbo_v2_5"
  bgm:
    # R-R18: BGM 自動埋込も opt-in
    required: false           # default OFF。true なら assets/bgm/*.mp3 を <Audio> で全 shot 通敷
    selection: "auto"         # auto / explicit
    # explicit_file: "energetic-01.mp3"
